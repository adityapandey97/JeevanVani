# JeevanVaani Backend Production Environment Configuration
# SIH26097 - AI-Driven Voice Assistant for Livelihood Mapping & NSQF-Aligned Skilling (PM-AJAY GIA)
# Team: UnicodeX

# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production

# ==========================================
# Database Configuration (Multi-Engine)
# 1. MongoDB (Primary document store for cloud deployment)
# 2. PostgreSQL (Optional relational engine)
# 3. SQLite (Zero-config embedded fallback: backend/jeevanvani.sqlite)
# ==========================================
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/jeevanvani?retryWrites=true&w=majority
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeevanvani
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=jeevanvani

# ==========================================
# Cache & Distributed Store (Redis)
# If Redis is unavailable, the in-memory cache adapter automatically activates.
# ==========================================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==========================================
# AI / LLM Engine (Optional)
# If no API key is provided, JeevanVaani operates using its built-in rule-based
# anti-hallucination NLP and deterministic 6-factor recommendation engines.
# ==========================================
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# PYTHON_AI_URL=http://127.0.0.1:8000

# ==========================================
# Government Integrations & External Data Sources
# (Skill India Digital, NSDC, PM-AJAY GIA, DGT)
# Adapters fall back gracefully to local verified government datasets if live APIs are unreachable.
# ==========================================
SKILL_INDIA_BASE_URL=https://www.skillindiadigital.gov.in
# SKILL_INDIA_API_URL=https://api.skillindiadigital.gov.in/v1
# SKILL_INDIA_API_KEY=

NSDC_BASE_URL=https://www.nsdcindia.org
# NSDC_API_URL=https://api.nsdcindia.org/v1
# NSDC_API_KEY=

PMAJAY_BASE_URL=https://pmajay.dosje.gov.in
# PMAJAY_API_URL=https://pmajay.dosje.gov.in/api
PMAJAY_TIMEOUT_MS=6000

DGT_BASE_URL=https://dgt.gov.in
# DGT_API_URL=https://dgt.gov.in/api

# ==========================================
# Object & Artifact Storage
# Drivers: 'local' (filesystem) or 's3' (AWS S3 / MinIO)
# ==========================================
OBJECT_STORE_DRIVER=local
OBJECT_STORE_LOCAL_DIR=uploads/object_store
OBJECT_STORE_BASE_URL=/uploads/object_store
# S3_BUCKET=jeevanvani-artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
